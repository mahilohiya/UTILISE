# Database
DATABASE_URL="postgresql://rams_user:rams_password@localhost:5432/rams_db"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="dev-secret-change-in-production"

# Email domain restriction
ALLOWED_EMAIL_DOMAIN="msrit.edu"

# Redis (optional — for BullMQ workers & Upstash rate limiting)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI Search Assistant (optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Smart Notes Generator (optional — get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Email notifications (optional)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Observability (optional)
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
