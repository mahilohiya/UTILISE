generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  LIBRARIAN
  ADMIN
  SUPERADMIN
}

enum BookCopyStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  RESERVED
}

enum IssueStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum RequestStatus {
  PENDING
  APPROVED
  ORDERED
  FULFILLED
  REJECTED
}

enum ClaimStatus {
  REPORTED
  FEE_ISSUED
  PAID
  RESOLVED
}

// --- Academic Structure ---

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. "2025-26"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  semesters Semester[]
  users     User[]
  books     Book[]
}

model Semester {
  id           String     @id @default(cuid())
  number       Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  subjects     Subject[]
  users        User[]
  books        Book[]

  @@unique([departmentId, number])
}

model Subject {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  credits    Int
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  books      Book[]
}

// --- Users & RBAC ---

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  usn          String?   @unique
  role         Role      @default(STUDENT)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  semesterId   String?
  semester     Semester? @relation(fields: [semesterId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  issueRecords IssueRecord[]
  reservations Reservation[]
  notifications Notification[]
  auditLogs    AuditLog[]
  bookRequests BookRequest[]
  digitalLogs  DigitalAccessLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Library Domain ---

model Book {
  id              String   @id @default(cuid())
  isbn            String?  @unique
  title           String
  author          String
  publisher       String?
  edition         String?
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  semesterId      String?
  semester        Semester? @relation(fields: [semesterId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  coverImageUrl   String?
  tags            String[]
  digitalCopyUrl  String?
  shelfLocation   String?
  price           Float?

  copies       BookCopy[]
  reservations Reservation[]

  @@index([title])
  @@index([author])
  @@index([departmentId, semesterId])
}

model BookCopy {
  id           String         @id @default(cuid())
  bookId       String
  book         Book           @relation(fields: [bookId], references: [id])
  barcode      String         @unique
  status       BookCopyStatus @default(AVAILABLE)
  issueRecords IssueRecord[]
}

model IssueRecord {
  id           String      @id @default(cuid())
  bookCopyId   String
  bookCopy     BookCopy    @relation(fields: [bookCopyId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  issueDate    DateTime    @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  fineAmount   Float       @default(0)
  fineStatus   String?
  renewedCount Int         @default(0)
  status       IssueStatus @default(ACTIVE)
  lostClaims   LostBookClaim[]

  @@index([userId, status])
  @@index([dueDate, status])
}

model Reservation {
  id          String            @id @default(cuid())
  bookId      String
  book        Book              @relation(fields: [bookId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  requestedAt DateTime          @default(now())
  status      ReservationStatus @default(PENDING)
  notifiedAt  DateTime?
  holdUntil   DateTime?

  @@index([bookId, status])
  @@index([userId, status])
}

model FineRule {
  id              String @id @default(cuid())
  perDayAmount    Float
  gracePeriodDays Int
  maxFineCap      Float
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
}

// --- Real-Life Problem Tables ---

model BookRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  title       String
  author      String?
  reason      String?
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
}

model LostBookClaim {
  id             String      @id @default(cuid())
  issueRecordId  String
  issueRecord    IssueRecord @relation(fields: [issueRecordId], references: [id])
  reportedAt     DateTime    @default(now())
  replacementFee Float
  status         ClaimStatus @default(REPORTED)
}

model DigitalAccessLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  bookId     String
  accessedAt DateTime @default(now())

  @@index([bookId, accessedAt])
}
